# Google Apps Script web app URL that records scheduled exam registrations and results (scripts/results-sheet-apps-script.gs)
VITE_RESULTS_WEBHOOK_URL=
# Secret value for /examen-programado?preview=<key>, which skips the slot lock so the admin can test. Reports are marked PREVIEW.
VITE_PREVIEW_KEY=
# Secret URL token for /examen-programado?retake=<token>. Reopens a saved registration and skips the slot window; reports remain real (not previews).
VITE_RETAKE_TOKEN=
